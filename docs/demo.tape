# Terminal recording for the README. Render with `make demo` (needs vhs).
# The capture is synthetic: testdata/demo/broken-login.har, generated by
# internal/testutil (example.com domains, a throwaway key).

Output docs/demo.gif

Set Shell "bash"
Set FontSize 15
Set Width 1200
Set Height 760
Set Padding 20
Set TypingSpeed 40ms
Set Theme "Catppuccin Mocha"

# Put the freshly built binary on PATH and start in the demo folder,
# off camera.
Hide
Type "export PATH=$PWD/bin:$PATH PS1='$ ' && cd testdata/demo && rm -f shareable.har && clear"
Enter
Show

Type "ssotrace diagnose broken-login.har"
Sleep 400ms
Enter
Sleep 6s

Type "clear && ssotrace scan broken-login.har"
Sleep 400ms
Enter
Sleep 4s

Type "clear && ssotrace redact broken-login.har -o shareable.har && ssotrace scan shareable.har"
Sleep 400ms
Enter
Sleep 4s

Hide
Type "rm -f shareable.har"
Enter
